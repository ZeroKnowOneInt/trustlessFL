# Client-only Linux image: no compiler, MP-SPDZ, Ray or simulation dependency.
# Build context: this Dockerfile and one locally built TrustlessFL wheel.
FROM ubuntu@sha256:534baea6a22c03a63003dbc8dbe78fe34bc0d7e595d9a9dc9834884ff530eb55
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends python3-venv ca-certificates openssl passwd && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:/usr/local/bin:/usr/bin:/bin"
COPY *.whl /tmp/wheels/
RUN pip install --no-cache-dir /tmp/wheels/*.whl && pip install --no-cache-dir 'torch==2.8.0' --index-url https://download.pytorch.org/whl/cpu
RUN if id ubuntu >/dev/null 2>&1; then /usr/sbin/usermod -l operator -d /home/operator -m ubuntu; else /usr/sbin/useradd -m -u 1000 operator; fi
ENV HOME="/home/operator" FLWR_TELEMETRY_ENABLED="0" FLWR_DISABLE_UPDATE_CHECK="1"
USER operator
WORKDIR /home/operator
CMD ["python", "-c", "import time; time.sleep(3600)"]
